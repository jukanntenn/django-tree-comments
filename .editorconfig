root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{html,djhtml,jinja,jinja2}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{js,ts,jsx,tsx,css,scss,json,yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
